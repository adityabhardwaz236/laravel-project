APP_NAME=CertChain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
QR_BASE_URL=http://localhost

LOG_CHANNEL=stack

# Queue (required for background blockchain sync jobs)
QUEUE_CONNECTION=database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certchain
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=certchain
# DB_USERNAME=root
# DB_PASSWORD=

# Blockchain Config (Get free keys from https://infura.io)
INFURA_PROJECT_ID=your_infura_project_id_here
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
OWNER_PRIVATE_KEY=your_wallet_private_key_here
ETH_NETWORK=sepolia

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@certchain.com"
MAIL_FROM_NAME="${APP_NAME}"
